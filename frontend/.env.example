# ==============================================================================
# AirSense Environment Variables (.env.example)
# Copy this file to .env.local for local frontend development
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------

# FastAPI Backend URL used by Next.js components to fetch AQI, OLAP, and ML data
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Next.js Application Origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application Environment Mode (development / staging / production)
NEXT_PUBLIC_APP_ENV=development

# Optional: CARTO API Key for high-frequency map tile rendering
# Leave blank to use CARTO's default anonymous public tile tier
NEXT_PUBLIC_CARTO_API_KEY=
