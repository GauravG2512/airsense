# ==============================================================================
# AirSense Backend Environment Variables (.env.example)
# Copy this file to .env in the backend/ directory
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Environment Mode (development / production)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# AirSense Atmospheric Neural Foundation Engine API Token
# Required for real-time nationwide telemetry synthesis & zero-shot atmospheric foundation inference
AIRSENSE_MODEL_API_KEY=
